<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Opt-in: allows direct filesystem reads for library artwork resolution. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".TwinLoreApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TwinLore"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TwinLore">
        </activity>
        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPixel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel"
            android:roundIcon="@mipmap/ic_launcher_pixel_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:roundIcon="@mipmap/ic_launcher_gold_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityCyber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyber"
            android:roundIcon="@mipmap/ic_launcher_cyber_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityDemonic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_demonic"
            android:roundIcon="@mipmap/ic_launcher_demonic_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityAdventure"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_adventure"
            android:roundIcon="@mipmap/ic_launcher_adventure_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityNoire"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_noire"
            android:roundIcon="@mipmap/ic_launcher_noire_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!--
            Declares Game Twin as an icon pack. Launchers that support packs
            discover them by these actions and read assets/appfilter.xml, which
            maps each edition alias to its drawable. That is how a special
            edition reaches a frontend which draws the package-level icon.

            Side effect, accepted: Game Twin shows up in every launcher's
            icon-pack picker.
        -->
        <activity
            android:name=".IconPackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoDisplay">
            <meta-data android:name="com.novalauncher.theme" android:value="appfilter" />
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.novalauncher.THEME" />
                <action android:name="com.teslacoilsw.launcher.THEME" />
                <action android:name="com.anddoes.launcher.THEME" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="com.fede.launcher.THEME_ICONPACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".services.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
        <!--
            Holds the process at foreground-service priority while the overlay
            panel is up, so doze and battery optimizers leave its network alone.
            It does no work of its own; see OverlayNetworkService.
        -->
        <service
            android:name=".services.OverlayNetworkService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps network access for the in-game overlay panel while a game is in the foreground" />
        </service>
        <!--
            Invisible by design. It exists only to host the system's screen
            capture consent sheet, which needs an activity to return a result
            to and which the fold panel's overlay window therefore cannot ask
            for itself. Translucent and with no title so the sheet appears over
            whatever is already on screen instead of over a blank app.
            excludeFromRecents keeps it out of the task switcher. Deliberately
            NOT noHistory: that finishes an activity as soon as it stops, which
            is exactly what happens behind the consent dialog on some devices,
            and the granted result would never be delivered to
            onActivityResult. The activity finishes itself on both paths.
        -->
        <activity
            android:name=".services.ScreenCaptureConsentActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>

